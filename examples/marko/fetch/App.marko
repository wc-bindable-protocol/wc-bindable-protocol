import { wcBindable } from "@wc-bindable/marko";
import "../../vanilla/fetch/my-fetch.js";
import appSource from "./App.marko?raw";

class {
  onCreate() {
    this.state = {
      values: {},
      url: "https://jsonplaceholder.typicode.com/posts/1",
    };
  }
  onMount() {
    this.unbind = wcBindable(this.getEl("fetch"), (name, value) => {
      this.state.values = { ...this.state.values, [name]: value };
    });
  }
  onDestroy() {
    if (this.unbind) this.unbind();
  }
  onUrlInput(ev) {
    this.state.url = ev.target.value;
  }
  onFetch() {
    const el = this.getEl("fetch");
    el.url = this.state.url;
    el.fetch();
  }
  onAbort() {
    const el = this.getEl("fetch");
    if (el.abort) el.abort();
  }
}

$ const FETCH_TAG = "my-fetch";
$ const loading = !!state.values.loading;
$ const error = state.values.error;
$ const value = state.values.value;
$ const status = state.values.status;
$ const loadingBg = loading ? "#fef3c7" : "#d1fae5";
$ const loadingFg = loading ? "#92400e" : "#065f46";

<div style="font-family: system-ui, sans-serif; max-width: 700px; margin: 40px auto; padding: 0 20px">
  <p><a href="/index.html">&larr; Examples</a></p>
  <h1>wc-bindable: Marko - Fetch</h1>

  <${FETCH_TAG} key="fetch" manual/>

  <div style="margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px">
    <div style="font-weight: 600; margin-bottom: 8px">Request</div>
    <div style="display: flex; gap: 8px; align-items: center">
      <input
        type="text"
        value=state.url
        on-input("onUrlInput")
        style="flex: 1; padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px"
      />
      <button
        on-click("onFetch")
        disabled=loading
        style="padding: 6px 16px; border: 1px solid #ccc; border-radius: 4px; background: #f5f5f5; cursor: pointer">
        Fetch
      </button>
      <button
        on-click("onAbort")
        style="padding: 6px 16px; border: 1px solid #ccc; border-radius: 4px; background: #f5f5f5; cursor: pointer">
        Abort
      </button>
    </div>
  </div>

  <div style="margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px">
    <div style="font-weight: 600; margin-bottom: 8px">Bound State (via wcBindable)</div>
    <div style="display: flex; gap: 16px; font-size: 14px; margin-bottom: 8px">
      <span style=`padding: 2px 8px; border-radius: 4px; background: ${loadingBg}; color: ${loadingFg}`>
        loading: <strong>${String(loading)}</strong>
      </span>
      <span>status: <strong>${String(status ?? "-")}</strong></span>
    </div>
    <if(error)>
      <div style="background: #fee2e2; color: #991b1b; padding: 8px; border-radius: 4px; margin-bottom: 8px">
        ${JSON.stringify(error, null, 2)}
      </div>
    </if>
    <pre style="background: #f5f5f5; padding: 12px; border-radius: 4px; max-height: 300px; overflow: auto; font-size: 13px; white-space: pre-wrap; word-break: break-word">${value ? JSON.stringify(value, null, 2) : "- No response yet -"}</pre>
  </div>

  <details style="margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px">
    <summary style="font-weight: 600; margin-bottom: 8px; cursor: pointer">Source Code</summary>
    <pre style="font-size: 13px; overflow: auto; margin: 8px 0 0; padding: 12px; background: #f8fafc; border-radius: 4px"><code>${appSource}</code></pre>
  </details>
</div>
