<app>
  <div style="font-family: system-ui, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px">
    <p><a href="/index.html">← Examples</a></p>
    <h1>wc-bindable: Riot.js — Counter</h1>

    <div style="margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px">
      <div style="font-weight: 600; margin-bottom: 8px">Counter Component</div>
      <my-counter></my-counter>
    </div>

    <div style="margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px">
      <div style="font-weight: 600; margin-bottom: 8px">Bound Values (via createWcBindable)</div>
      <pre style="font-size: 14px; color: #2563eb">{ JSON.stringify(state.values, null, 2) }</pre>
    </div>

    <details style="margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px">
      <summary style="font-weight: 600; cursor: pointer">Source Code</summary>
      <pre style="font-size: 13px; overflow: auto; margin: 8px 0 0; padding: 12px; background: #f8fafc; border-radius: 4px"><code>{ source }</code></pre>
    </details>
  </div>

  <script>
    import { createWcBindable } from "@wc-bindable/riot";
    import "../../vanilla/counter/my-counter.js";
    import source from "./App.riot?raw";

    export default {
      source,
      onBeforeMount() {
        this.binder = createWcBindable(
          { count: 0 },
          { update: () => this.update() },
        );
        this.state = { values: this.binder.values };
      },
      onMounted() {
        this.binder.bind(this.$("my-counter"));
      },
      onBeforeUnmount() {
        this.binder.unbind();
      },
    };
  </script>
</app>
