{"version":3,"names":["card","label","StencilLitTodoApp","__stencil_proxyCustomElement","HTMLElement","constructor","registerHost","this","todo","WcBindableController","todoRef","items","count","connectedCallback","connect","disconnectedCallback","disconnect","componentDidRender","update","render","v","values","h","key","style","fontFamily","maxWidth","margin","padding","href","parseStyle","display","background","color","borderRadius","fontSize","marginLeft","String","ref","el","JSON","stringify","length","map","item"],"sources":["src/components/stencil-lit-todo/stencil-lit-todo.tsx"],"sourcesContent":["import { Component, h } from \"@stencil/core\";\nimport { WcBindableController } from \"@wc-bindable/stencil\";\nimport { parseStyle } from \"../../util/parse-style\";\n\ninterface LitTodoValues {\n  items: string[];\n  count: number;\n}\n\nconst card =\n  \"margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px\";\nconst label = \"font-weight: 600; margin-bottom: 8px\";\n\n@Component({ tag: \"stencil-lit-todo-app\", shadow: false })\nexport class StencilLitTodoApp {\n  private todoRef?: HTMLElement;\n  private todo = new WcBindableController<LitTodoValues>(\n    this,\n    () => this.todoRef,\n    { items: [], count: 0 },\n  );\n\n  connectedCallback() {\n    this.todo.connect();\n  }\n\n  disconnectedCallback() {\n    this.todo.disconnect();\n  }\n\n  componentDidRender() {\n    this.todo.update();\n  }\n\n  render() {\n    const v = this.todo.values;\n    return (\n      <div style={{ fontFamily: \"system-ui, sans-serif\", maxWidth: \"600px\", margin: \"40px auto\", padding: \"0 20px\" }}>\n        <p><a href=\"/index.html\">&larr; Examples</a></p>\n        <h1>wc-bindable: Stencil &mdash; Lit Todo</h1>\n\n        <div style={parseStyle(card)}>\n          <div style={parseStyle(label)}>\n            Lit Todo Component\n            {v.count != null ? (\n              <span style={{\n                display: \"inline-block\",\n                background: \"#2563eb\",\n                color: \"white\",\n                borderRadius: \"12px\",\n                padding: \"2px 10px\",\n                fontSize: \"13px\",\n                marginLeft: \"8px\",\n              }}>\n                {String(v.count)}\n              </span>\n            ) : null}\n          </div>\n          <lit-todo ref={(el?: HTMLElement) => (this.todoRef = el)}></lit-todo>\n        </div>\n\n        <div style={parseStyle(card)}>\n          <div style={parseStyle(label)}>Bound Values (via WcBindableController)</div>\n          <pre style={{ fontSize: \"14px\", color: \"#2563eb\" }}>\n            {JSON.stringify(v, null, 2)}\n          </pre>\n        </div>\n\n        {v.items && v.items.length > 0 ? (\n          <div style={parseStyle(card)}>\n            <div style={parseStyle(label)}>Stencil-rendered item list (from bound state)</div>\n            <ul>{v.items.map((item) => <li>{item}</li>)}</ul>\n          </div>\n        ) : null}\n      </div>\n    );\n  }\n}\n"],"mappings":"uEASA,MAAMA,EACJ,4EACF,MAAMC,EAAQ,uC,MAGDC,EAAiBC,EAAA,MAAAD,UAAAE,EAD9B,WAAAC,CAAAC,G,4CAGUC,KAAAC,KAAO,IAAIC,EACjBF,MACA,IAAMA,KAAKG,SACX,CAAEC,MAAO,GAAIC,MAAO,GA0DvB,CAvDC,iBAAAC,GACEN,KAAKC,KAAKM,S,CAGZ,oBAAAC,GACER,KAAKC,KAAKQ,Y,CAGZ,kBAAAC,GACEV,KAAKC,KAAKU,Q,CAGZ,MAAAC,GACE,MAAMC,EAAIb,KAAKC,KAAKa,OACpB,OACEC,EAAA,OAAAC,IAAA,2CAAKC,MAAO,CAAEC,WAAY,wBAAyBC,SAAU,QAASC,OAAQ,YAAaC,QAAS,WAClGN,EAAA,KAAAC,IAAA,4CAAGD,EAAA,KAAAC,IAAA,2CAAGM,KAAK,eAAa,eACxBP,EAAA,MAAAC,IAAA,+EAEAD,EAAA,OAAAC,IAAA,2CAAKC,MAAOM,EAAW9B,IACrBsB,EAAA,OAAAC,IAAA,2CAAKC,MAAOM,EAAW7B,IAAM,qBAE1BmB,EAAER,OAAS,KACVU,EAAA,QAAME,MAAO,CACXO,QAAS,eACTC,WAAY,UACZC,MAAO,QACPC,aAAc,OACdN,QAAS,WACTO,SAAU,OACVC,WAAY,QAEXC,OAAOjB,EAAER,QAEV,MAENU,EAAA,YAAAC,IAAA,2CAAUe,IAAMC,GAAsBhC,KAAKG,QAAU6B,KAGvDjB,EAAA,OAAAC,IAAA,2CAAKC,MAAOM,EAAW9B,IACrBsB,EAAA,OAAAC,IAAA,2CAAKC,MAAOM,EAAW7B,IAAM,2CAC7BqB,EAAA,OAAAC,IAAA,2CAAKC,MAAO,CAAEW,SAAU,OAAQF,MAAO,YACpCO,KAAKC,UAAUrB,EAAG,KAAM,KAI5BA,EAAET,OAASS,EAAET,MAAM+B,OAAS,EAC3BpB,EAAA,OAAKE,MAAOM,EAAW9B,IACrBsB,EAAA,OAAKE,MAAOM,EAAW7B,IAAM,iDAC7BqB,EAAA,UAAKF,EAAET,MAAMgC,KAAKC,GAAStB,EAAA,UAAKsB,OAEhC,K","ignoreList":[]}