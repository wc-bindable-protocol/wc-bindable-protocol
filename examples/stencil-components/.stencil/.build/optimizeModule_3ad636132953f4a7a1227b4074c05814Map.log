{"version":3,"names":["section","label","StencilFetchApp","__stencil_proxyCustomElement","HTMLElement","constructor","registerHost","this","url","fetcher","WcBindableController","fetchRef","handleFetch","el","fetch","handleAbort","_a","abort","connectedCallback","connect","disconnectedCallback","disconnect","componentDidRender","update","render","v","values","h","key","style","fontFamily","maxWidth","margin","padding","href","ref","manual","parseStyle","display","gap","alignItems","type","value","onInput","e","target","flex","border","borderRadius","fontSize","onClick","disabled","loading","background","cursor","marginBottom","color","String","_b","status","error","JSON","stringify","maxHeight","overflow","whiteSpace","wordBreak"],"sources":["src/components/stencil-fetch/stencil-fetch.tsx"],"sourcesContent":["import { Component, State, h } from \"@stencil/core\";\nimport { WcBindableController } from \"@wc-bindable/stencil\";\nimport { parseStyle } from \"../../util/parse-style\";\n\ninterface MyFetchValues {\n  value: unknown;\n  loading: boolean;\n  error: { status: number; statusText: string; body: string } | null;\n  status: number;\n}\n\ninterface MyFetchElement extends HTMLElement {\n  url: string;\n  method: string;\n  manual: boolean;\n  fetch(): Promise<unknown>;\n  abort(): void;\n}\n\nconst section =\n  \"margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px\";\nconst label = \"font-weight: 600; margin-bottom: 8px\";\n\n@Component({ tag: \"stencil-fetch-app\", shadow: false })\nexport class StencilFetchApp {\n  @State() url = \"https://jsonplaceholder.typicode.com/posts/1\";\n\n  private fetchRef?: MyFetchElement;\n  private fetcher = new WcBindableController<MyFetchValues>(\n    this,\n    () => this.fetchRef,\n  );\n\n  connectedCallback() {\n    this.fetcher.connect();\n  }\n\n  disconnectedCallback() {\n    this.fetcher.disconnect();\n  }\n\n  componentDidRender() {\n    this.fetcher.update();\n  }\n\n  private handleFetch = () => {\n    const el = this.fetchRef;\n    if (!el) return;\n    el.url = this.url;\n    el.fetch();\n  };\n\n  private handleAbort = () => {\n    this.fetchRef?.abort();\n  };\n\n  render() {\n    const v = this.fetcher.values;\n    return (\n      <div style={{ fontFamily: \"system-ui, sans-serif\", maxWidth: \"700px\", margin: \"40px auto\", padding: \"0 20px\" }}>\n        <p><a href=\"/index.html\">&larr; Examples</a></p>\n        <h1>wc-bindable: Stencil &mdash; Fetch</h1>\n\n        <my-fetch\n          ref={(el?: HTMLElement) => (this.fetchRef = el as MyFetchElement | undefined)}\n          manual\n        ></my-fetch>\n\n        <div style={parseStyle(section)}>\n          <div style={parseStyle(label)}>Request</div>\n          <div style={{ display: \"flex\", gap: \"8px\", alignItems: \"center\" }}>\n            <input\n              type=\"text\"\n              value={this.url}\n              onInput={(e: Event) => (this.url = (e.target as HTMLInputElement).value)}\n              style={{ flex: \"1\", padding: \"6px 10px\", border: \"1px solid #ccc\", borderRadius: \"4px\", fontSize: \"14px\" }}\n            />\n            <button\n              onClick={this.handleFetch}\n              disabled={!!v.loading}\n              style={{ padding: \"6px 16px\", border: \"1px solid #ccc\", borderRadius: \"4px\", background: \"#f5f5f5\", cursor: \"pointer\" }}\n            >\n              Fetch\n            </button>\n            <button\n              onClick={this.handleAbort}\n              style={{ padding: \"6px 16px\", border: \"1px solid #ccc\", borderRadius: \"4px\", background: \"#f5f5f5\", cursor: \"pointer\" }}\n            >\n              Abort\n            </button>\n          </div>\n        </div>\n\n        <div style={parseStyle(section)}>\n          <div style={parseStyle(label)}>Bound State (via WcBindableController)</div>\n          <div style={{ display: \"flex\", gap: \"16px\", fontSize: \"14px\", marginBottom: \"8px\" }}>\n            <span style={{\n              padding: \"2px 8px\",\n              borderRadius: \"4px\",\n              background: v.loading ? \"#fef3c7\" : \"#d1fae5\",\n              color: v.loading ? \"#92400e\" : \"#065f46\",\n            }}>\n              loading: <strong>{String(v.loading ?? false)}</strong>\n            </span>\n            <span>status: <strong>{String(v.status ?? \"—\")}</strong></span>\n          </div>\n          {v.error ? (\n            <div style={{ background: \"#fee2e2\", color: \"#991b1b\", padding: \"8px\", borderRadius: \"4px\", marginBottom: \"8px\" }}>\n              {JSON.stringify(v.error, null, 2)}\n            </div>\n          ) : null}\n          <pre style={{\n            background: \"#f5f5f5\",\n            padding: \"12px\",\n            borderRadius: \"4px\",\n            maxHeight: \"300px\",\n            overflow: \"auto\",\n            fontSize: \"13px\",\n            whiteSpace: \"pre-wrap\",\n            wordBreak: \"break-word\",\n          }}>\n            {v.value ? JSON.stringify(v.value, null, 2) : \"— No response yet —\"}\n          </pre>\n        </div>\n      </div>\n    );\n  }\n}\n"],"mappings":"uEAmBA,MAAMA,EACJ,4EACF,MAAMC,EAAQ,uC,MAGDC,EAAeC,EAAA,MAAAD,UAAAE,EAD5B,WAAAC,CAAAC,G,4CAEWC,KAAAC,IAAM,+CAGPD,KAAAE,QAAU,IAAIC,EACpBH,MACA,IAAMA,KAAKI,WAeLJ,KAAAK,YAAc,KACpB,MAAMC,EAAKN,KAAKI,SAChB,IAAKE,EAAI,OACTA,EAAGL,IAAMD,KAAKC,IACdK,EAAGC,OAAO,EAGJP,KAAAQ,YAAc,K,OACpBC,EAAAT,KAAKI,YAAQ,MAAAK,SAAA,SAAAA,EAAEC,OAAO,CA0EzB,CA9FC,iBAAAC,GACEX,KAAKE,QAAQU,S,CAGf,oBAAAC,GACEb,KAAKE,QAAQY,Y,CAGf,kBAAAC,GACEf,KAAKE,QAAQc,Q,CAcf,MAAAC,G,QACE,MAAMC,EAAIlB,KAAKE,QAAQiB,OACvB,OACEC,EAAA,OAAAC,IAAA,2CAAKC,MAAO,CAAEC,WAAY,wBAAyBC,SAAU,QAASC,OAAQ,YAAaC,QAAS,WAClGN,EAAA,KAAAC,IAAA,4CAAGD,EAAA,KAAAC,IAAA,2CAAGM,KAAK,eAAa,eACxBP,EAAA,MAAAC,IAAA,4EAEAD,EAAA,YAAAC,IAAA,2CACEO,IAAMtB,GAAsBN,KAAKI,SAAWE,EAC5CuB,OAAM,OAGRT,EAAA,OAAAC,IAAA,2CAAKC,MAAOQ,EAAWrC,IACrB2B,EAAA,OAAAC,IAAA,2CAAKC,MAAOQ,EAAWpC,IAAM,WAC7B0B,EAAA,OAAAC,IAAA,2CAAKC,MAAO,CA