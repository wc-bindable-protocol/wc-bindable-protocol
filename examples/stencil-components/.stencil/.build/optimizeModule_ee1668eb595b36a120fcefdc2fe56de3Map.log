{"version":3,"names":["card","label","StencilCounterApp","__stencil_proxyCustomElement","HTMLElement","constructor","registerHost","this","counter","WcBindableController","counterRef","connectedCallback","connect","disconnectedCallback","disconnect","componentDidRender","update","render","h","key","style","fontFamily","maxWidth","margin","padding","href","parseStyle","ref","el","fontSize","color","JSON","stringify","values"],"sources":["src/components/stencil-counter/stencil-counter.tsx"],"sourcesContent":["import { Component, h } from \"@stencil/core\";\nimport { WcBindableController } from \"@wc-bindable/stencil\";\nimport { parseStyle } from \"../../util/parse-style\";\n\ninterface MyCounterValues {\n  count: number;\n}\n\ninterface MyCounterElement extends HTMLElement {\n  count: number;\n}\n\nconst card =\n  \"margin: 24px 0; padding: 16px; border: 1px solid #ddd; border-radius: 8px\";\nconst label = \"font-weight: 600; margin-bottom: 8px\";\n\n@Component({ tag: \"stencil-counter-app\", shadow: false })\nexport class StencilCounterApp {\n  private counterRef?: MyCounterElement;\n  private counter = new WcBindableController<MyCounterValues>(\n    this,\n    () => this.counterRef,\n  );\n\n  connectedCallback() {\n    this.counter.connect();\n  }\n\n  disconnectedCallback() {\n    this.counter.disconnect();\n  }\n\n  componentDidRender() {\n    this.counter.update();\n  }\n\n  render() {\n    return (\n      <div style={{ fontFamily: \"system-ui, sans-serif\", maxWidth: \"600px\", margin: \"40px auto\", padding: \"0 20px\" }}>\n        <p><a href=\"/index.html\">&larr; Examples</a></p>\n        <h1>wc-bindable: Stencil &mdash; Counter</h1>\n\n        <div style={parseStyle(card)}>\n          <div style={parseStyle(label)}>Counter Component</div>\n          <my-counter ref={(el?: HTMLElement) => (this.counterRef = el as MyCounterElement | undefined)}></my-counter>\n        </div>\n\n        <div style={parseStyle(card)}>\n          <div style={parseStyle(label)}>Bound Values (via WcBindableController)</div>\n          <pre style={{ fontSize: \"14px\", color: \"#2563eb\" }}>\n            {JSON.stringify(this.counter.values, null, 2)}\n          </pre>\n        </div>\n      </div>\n    );\n  }\n}\n\n"],"mappings":"uEAYA,MAAMA,EACJ,4EACF,MAAMC,EAAQ,uC,MAGDC,EAAiBC,EAAA,MAAAD,UAAAE,EAD9B,WAAAC,CAAAC,G,4CAGUC,KAAAC,QAAU,IAAIC,EACpBF,MACA,IAAMA,KAAKG,YAmCd,CAhCC,iBAAAC,GACEJ,KAAKC,QAAQI,S,CAGf,oBAAAC,GACEN,KAAKC,QAAQM,Y,CAGf,kBAAAC,GACER,KAAKC,QAAQQ,Q,CAGf,MAAAC,GACE,OACEC,EAAA,OAAAC,IAAA,2CAAKC,MAAO,CAAEC,WAAY,wBAAyBC,SAAU,QAASC,OAAQ,YAAaC,QAAS,WAClGN,EAAA,KAAAC,IAAA,4CAAGD,EAAA,KAAAC,IAAA,2CAAGM,KAAK,eAAa,eACxBP,EAAA,MAAAC,IAAA,8EAEAD,EAAA,OAAAC,IAAA,2CAAKC,MAAOM,EAAW1B,IACrBkB,EAAA,OAAAC,IAAA,2CAAKC,MAAOM,EAAWzB,IAAM,qBAC7BiB,EAAA,cAAAC,IAAA,2CAAYQ,IAAMC,GAAsBrB,KAAKG,WAAakB,KAG5DV,EAAA,OAAAC,IAAA,2CAAKC,MAAOM,EAAW1B,IACrBkB,EAAA,OAAAC,IAAA,2CAAKC,MAAOM,EAAWzB,IAAM,2CAC7BiB,EAAA,OAAAC,IAAA,2CAAKC,MAAO,CAAES,SAAU,OAAQC,MAAO,YACpCC,KAAKC,UAAUzB,KAAKC,QAAQyB,OAAQ,KAAM,K","ignoreList":[]}