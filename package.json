    "@qwik.dev/core": "^2.0.0-beta.35",
    "@riotjs/compiler": "^10.0.2",
    "@stencil/core": "^4.43.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/dom": "^10.4.1",
