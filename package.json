{
  "name": "wc-bindable-protocol",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/stencil/components"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
