{
  "name": "@wc-bindable/qwik",
  "version": "0.8.0",
  "description": "Qwik adapter for wc-bindable protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "default": "./dist/v2.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@wc-bindable/core": "^0.8.0"
  },
  "peerDependencies": {
    "@builder.io/qwik": ">=1",
    "@qwik.dev/core": "2.0.0-beta.35"
  },
  "peerDependenciesMeta": {
    "@builder.io/qwik": {
      "optional": true
    },
    "@qwik.dev/core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wc-bindable-protocol/wc-bindable-protocol.git",
    "directory": "packages/qwik"
  },
  "license": "MIT"
}
